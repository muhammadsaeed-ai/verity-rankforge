# Optional search data connectors. Without keys the app uses clearly labeled demo data.
# Modes: auto, multi (requires both live sources), brave, dataforseo, demo.
RANKFORGE_PROVIDER=auto
BRAVE_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

RANKFORGE_DB_PATH=./data/rankforge.sqlite3
RANKFORGE_REQUEST_TIMEOUT=15
RANKFORGE_WORKER_POLL_SECONDS=15

# Optional evidence-grounded OpenAI synthesis; OFF by default to avoid API cost.
RANKFORGE_AI_ANALYSIS=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
RANKFORGE_AI_TIMEOUT=30
RANKFORGE_USER_AGENT=VerityRankForge/0.1 (+https://github.com/muhammadsaeed-ai/verity-rankforge)
